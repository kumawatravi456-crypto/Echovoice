# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Public Configuration (Client-side, non-secret)
# Automatically sourced from firebase-applet-config.json in AI Studio.
# Can also be explicitly passed via Vite environment variables:
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0611544051"
VITE_FIREBASE_APP_ID="1:121109405607:web:6bc4158d0adacf5b7ee082"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0611544051.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="ai-studio-idequicklink-777e40b6-a549-402b-8397-32f377be005e"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0611544051.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="121109405607"
