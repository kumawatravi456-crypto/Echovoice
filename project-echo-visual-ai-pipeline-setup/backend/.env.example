# Groq conversation response generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Scribe realtime token issuance (never place this key in frontend variables)
ELEVENLABS_API_KEY=

# Local Vite development origins allowed to request single-use Scribe tokens
ECHO_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
